rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSystemAdmin() {
      return signedIn() &&
        request.auth.uid == "Zy63U0hXZSddx7g8x2hahFtO1d63";
    }

    function currentUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        currentUserProfile().data.active == true;
    }

    match /users/{userId} {
      // The fixed System Administrator UID may bootstrap its own profile.
      allow create: if isSystemAdmin() && userId == request.auth.uid;

      // Users can read their own profile; System Administrator can manage all.
      allow read: if signedIn() && (userId == request.auth.uid || isSystemAdmin());
      allow update, delete: if isSystemAdmin();
    }

    // Current development stage: no operational collections are opened yet.
    // They will receive explicit role/site-based rules when each module is built.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
